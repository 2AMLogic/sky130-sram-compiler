* sim/smoke/inverter.sp.in -- toolchain smoke deck, NOT part of the design.
* One minimal inverter from the PDK's logic MOS models, typical corner.
* @MODEL_FILE@ is substituted by run.sh; the deck hash is of this template.
.lib "@MODEL_FILE@" tt
.temp 25

Vdd vdd 0 1.8
Vin in 0 PULSE(0 1.8 1n 100p 100p 2n 5n)
XMP out in vdd vdd sky130_fd_pr__pfet_01v8 w=0.84 l=0.15
XMN out in 0 0 sky130_fd_pr__nfet_01v8 w=0.42 l=0.15
Cl out 0 5f

.control
  * DC operating point with the input held low, then high. Results go in
  * global `set` variables because each analysis opens a new plot.
  alter Vin dc = 0
  op
  print v(out)
  set op_lo = $&v(out)
  alter Vin dc = 1.8
  op
  print v(out)
  set op_hi = $&v(out)
  tran 10p 8n
  meas tran t_fall trig v(in) val=0.9 rise=1 targ v(out) val=0.9 fall=1
  meas tran t_rise trig v(in) val=0.9 fall=1 targ v(out) val=0.9 rise=1
  echo "SMOKE_RESULT op_in_low_vout=$op_lo op_in_high_vout=$op_hi"
  if $op_lo > 1.7 and $op_hi < 0.1
    echo "SMOKE_PASS"
  else
    echo "SMOKE_FAIL"
  end
.endc
.end
