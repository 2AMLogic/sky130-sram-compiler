{
  "netlist": "../tb/col_mc_hold_snm_neg.sp",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt_mm",
      "sf_mm",
      "fs_mm"
    ],
    "supply_v": {
      "vvdd": [
        1.62,
        1.98
      ]
    },
    "temperature_c": [
      125
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "VNRM 0 1 0.01"
  },
  "measurements": [
    {
      "name": "vtrip_a",
      "spice": ".meas dc vtrip_a when v(outa)=0.9 fall=1",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 300,
    "stage_model_inputs": true,
    "waveforms": true,
    "keep_artifacts": true,
    "save_vectors": [
      "v(in)",
      "v(outa)",
      "v(outb)"
    ]
  },
  "monte_carlo": {
    "n": 20,
    "seed": 20261019,
    "vary": "mismatch",
    "k_sigma": 3
  },
  "batch": {
    "max_units_per_job": 36,
    "poll_timeout_s": 5400
  }
}
