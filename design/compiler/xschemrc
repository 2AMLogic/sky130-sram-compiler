#### Project-local xschem configuration for the compiler periphery (issue #26). `klt netlist --rcfile` loads
#### this explicitly so the result does not depend on a user-level ~/.xschem/xschemrc.
set XSCHEM_LIBRARY_PATH {}
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices
if {[info exists env(PDK_ROOT)] && $env(PDK_ROOT) ne {}} {
  set PDK_ROOT $env(PDK_ROOT)
  set PDK [expr {[info exists env(PDK)] && $env(PDK) ne {} ? $env(PDK) : {sky130A}}]
  set pdk_xschemrc [file join $PDK_ROOT $PDK libs.tech xschem xschemrc]
  if {[file exists $pdk_xschemrc]} { source $pdk_xschemrc }
}
set REPO_ROOT [file dirname [file dirname [file dirname [file normalize [info script]]]]]
append XSCHEM_LIBRARY_PATH :[file join $REPO_ROOT design compiler]
set XSCHEM_START_WINDOW {}
